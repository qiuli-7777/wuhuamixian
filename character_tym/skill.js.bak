    ql_youlong: {
        comboSkill: true,
        mod: {
            aiOrder(player, card, num) {
                if (typeof card == "object") {
                    const evt = lib.skill.dcjianying.getLastUsed(player);
                    //这里要改，一个是技能id另一个是第二张牌的条件
                    if (evt?.card && !evt.ql_youlong && get.is.damageCard(card)) {
