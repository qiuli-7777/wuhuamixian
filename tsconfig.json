{
    "compilerOptions": {
      /* 基本选项 */
      "target": "ESNext",                          // 目标 JavaScript 版本
      "module": "ESNext",                          // 指定生成哪个模块系统代码
      "lib": ["DOM", "ESNext"],                    // 编译过程中需要引入的库文件枚举
      "allowJs": true,                             // 允许编译器编译 JS 文件
      "checkJs": false,                             // 在 JS 文件中报告错误
  
      /* 严格类型检查选项 */
      "strict": false,                              // 启用所有严格类型检查选项
      "noImplicitAny": false,                       // 在表达式和声明上有隐含的 any 类型时报错
  
      /* 模块解析选项 */
      "moduleResolution": "node",                  // 模块解析策略
      "baseUrl": "./",                      // 用于解析非相对模块名称的基目录
      "paths": {                                   // 路径映射，配合 baseUrl 使用
        "noname":["../../noname.js"],
        "nonameElement": ["../../node_modules/@types/noname-typings/nonameModules/noname/library/element/index.d.ts"],
        //"noname":["./noname.d.ts"]
      },
  
      /* 输出相关 */
      "outDir": "./dist",                          // 指定输出目录
      "removeComments": true,                      // 删除编译后的注释
      "sourceMap": false                            // 生成相应的 .map 文件
    },
    
    /* 文件范围控制 */
    "include": ["**/*.js", "**/*.vue", "**/*.css", "**/*.ts", "../../typings/skill.d.ts"],
    "exclude": [
      "node_modules",                              // 排除目录
      "**/node_modules",
      "dist",
      "audio",
      "skin"
    ],
    //"extends": "./configs/base.json"               // 继承另一个配置文件的配置
  }